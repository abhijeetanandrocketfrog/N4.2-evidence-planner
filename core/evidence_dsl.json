{
  "meta": {
    
    "name": "Eligibility Evidence DSL",
    "version": "1.0",

    "purpose": "Declarative definition of eligibility reasoning rules over EB blocks and HL segments extracted from a 271 response.",

    "dsl_structure": {
      "common_blocks": "Reusable rule blocks referenced by scenarios, primarily used for status checks.",
      "scenarios": "Independent eligibility questions defined as ordered step flows.",
      "scope": {
        "plan": "Scenario operates at plan level without any service (EB03) level iteration.",
        "service": "Scenario operates per service (EB03) input term."
      },
      "flow": "Ordered list of reasoning steps executed sequentially inside a scenario; new steps can be added by inserting another entry in the flow.",
      "fallback_concept": "Alternate action when a step yields no evidence; can broaden retrieval scope or redirect to another scenario."
    },

    "current_scenarios": {
      "1.x": "Financial responsibilities (Copay, Deductible, Out-of-Pocket Maximum, Coinsurance, Limitations)",
      "2.x": "Coverage information at plan and service levels",
      "3.x": "Pre-Service Requirements"
    },
    
    "step_types": {
      "prior_check": "References a rule from common_blocks to determine status using EB01/EB03 logic.",
      "retrieve": "Fetches EB blocks filtered by EB01, EB03 and optional segment presence.",
      "hl_lookup": "Fetches HL-level segments (e.g. DTP, REF) from patient space data.",
      "fallback": "Alternative step executed when primary retrieve or lookup yields no result.",
      "redirect": "Transfers control to another scenario."
    },

    "filters_supported": {
      "EB01": "Exact EB01 value match",
      "EB03": "Exact EB03 match, 'input', or 'any'",
      "segments": "Presence of segments such as DTP, REF, EB11"
    },

    "data_sources": {
      "eb_blocks_v5": "Structured EB segments parsed from 271",
      "patient_space_v01": "HL-level data parsed from 271"
    },

    "design_rules": [
      "All eligibility logic must be expressed through scenario steps.",
      "Status determination logic must be defined only inside common_blocks.",
      "Scenarios must represent a single atomic eligibility question.",
      "Fallback and redirection logic must be explicitly defined inside scenarios.",
      "Engine must not contain scenario-specific conditions."
    ]
  },

  "common_blocks": {

    "plan_active_check": {
      "type": "pre_check",
      "check": "plan_status",
      "table": "eb_blocks_v5",
      "match": {
        "EB03": "Health Benefit Plan Coverage"
      },

      "Active": {
        "EB01": [
          "Active Coverage",
          "Active - Full Risk Capitation",
          "Active - Services Capitated",
          "Active - Services Capitated to Primary Care Physician",
          "Active - Pending Investigation"
        ]
      },

      "Inactive": {
        "EB01": [
          "Inactive",
          "Inactive - Pending Eligibility Update",
          "Inactive - Pending Investigation"
        ]
      },

      "Non-Covered": {
        "EB01": [
          "Non-Covered"
        ]
      }
    },

    "service_active_check": {
      "type": "pre_check",
      "check": "service_status",
      "table": "eb_blocks_v5",

      "Active": {
        "EB01": [
          "Active Coverage",
          "Active - Full Risk Capitation",
          "Active - Services Capitated",
          "Active - Services Capitated to Primary Care Physician",
          "Active - Pending Investigation"
        ]
      },

      "Inactive": {
        "EB01": [
          "Inactive",
          "Inactive - Pending Eligibility Update",
          "Inactive - Pending Investigation"
        ]
      },

      "Non-Covered": {
        "EB01": [
          "Non-Covered"
        ]
      }
    }
  },

  "scenarios": {

    "1.1": {
      "description": "Co-Payment",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Co-Payment",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Co-Payment",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.2": {
      "description": "Deductible",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Deductible",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Deductible",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.3": {
      "description": "Out of Pocket (Stop Loss)",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Out of Pocket (Stop Loss)",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Out of Pocket (Stop Loss)",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.4": {
      "description": "Co-Insurance",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Co-Insurance",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Co-Insurance",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.5": {
      "description": "Limitations",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Limitations",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Limitations",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "2.1": {
      "description": "Plan Level Coverage",
      "scope": "plan",
      "flow": [
        { "prior_check": "plan_active_check" },
        {
          "type": "hl_lookup",
          "table": "patient_space_v01",
          "segments": ["DTP", "REF"],
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB03": "Health Benefit Plan Coverage",
            "segments": ["DTP", "REF"]
          }
        },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Primary Care Provider",
          "EB03": "any"
        }
      ]
    },

    "2.2": {
      "description": "Service Level Coverage",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB03": "input",
          "segments": ["DTP", "REF"],
          "fallback": {
            "redirect": "2.1"
          }
        }
      ]
    },

    "3.1": {
      "description": "Service Authorization",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "EB03": "input",
          "segments": ["EB11"]
        }
      ]
    }

  }
}
