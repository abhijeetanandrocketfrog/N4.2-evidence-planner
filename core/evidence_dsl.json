{
  "common_blocks": {

    "plan_active_check": {
      "type": "pre_check",
      "check": "plan_status",
      "table": "eb_blocks_v5",
      "match": {
        "EB03": "Health Benefit Plan Coverage"
      },

      "Active": {
        "EB01": [
          "Active Coverage",
          "Active - Full Risk Capitation",
          "Active - Services Capitated",
          "Active - Services Capitated to Primary Care Physician",
          "Active - Pending Investigation"
        ]
      },

      "Inactive": {
        "EB01": [
          "Inactive",
          "Inactive - Pending Eligibility Update",
          "Inactive - Pending Investigation"
        ]
      },

      "Non-Covered": {
        "EB01": [
          "Non-Covered"
        ]
      }
    },

    "service_active_check": {
      "type": "pre_check",
      "check": "service_status",
      "table": "eb_blocks_v5",

      "Active": {
        "EB01": [
          "Active Coverage",
          "Active - Full Risk Capitation",
          "Active - Services Capitated",
          "Active - Services Capitated to Primary Care Physician",
          "Active - Pending Investigation"
        ]
      },

      "Inactive": {
        "EB01": [
          "Inactive",
          "Inactive - Pending Eligibility Update",
          "Inactive - Pending Investigation"
        ]
      },

      "Non-Covered": {
        "EB01": [
          "Non-Covered"
        ]
      }
    }
  },

  "scenarios": {

    "1.1": {
      "description": "Co-Payment",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Co-Payment",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Co-Payment",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.2": {
      "description": "Deductible",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Deductible",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Deductible",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.3": {
      "description": "Out of Pocket (Stop Loss)",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Out of Pocket (Stop Loss)",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Out of Pocket (Stop Loss)",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.4": {
      "description": "Co-Insurance",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Co-Insurance",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Co-Insurance",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "1.5": {
      "description": "Limitations",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Limitations",
          "EB03": "input",
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB01": "Limitations",
            "EB03": "Health Benefit Plan Coverage"
          }
        }
      ]
    },

    "2.1": {
      "description": "Plan Level Coverage",
      "scope": "plan",
      "flow": [
        { "prior_check": "plan_active_check" },
        {
          "type": "hl_lookup",
          "table": "patient_space_v01",
          "segments": ["DTP", "REF"],
          "fallback": {
            "type": "retrieve",
            "table": "eb_blocks_v5",
            "EB03": "Health Benefit Plan Coverage",
            "segments": ["DTP", "REF"]
          }
        },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB01": "Primary Care Provider",
          "EB03": "any"
        }
      ]
    },

    "2.2": {
      "description": "Service Level Coverage",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "table": "eb_blocks_v5",
          "EB03": "input",
          "segments": ["DTP", "REF"],
          "fallback": {
            "redirect": "2.1"
          }
        }
      ]
    },

    "3.1": {
      "description": "Service Authorization",
      "scope": "service",
      "flow": [
        { "prior_check": "plan_active_check" },
        { "prior_check": "service_active_check" },
        {
          "type": "retrieve",
          "EB03": "input",
          "segments": ["EB11"]
        }
      ]
    }

  }
}
